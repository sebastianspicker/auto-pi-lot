{
  "name": "auto-pi-lot",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "Local-first graph orchestration for the Pi coding agent",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:unit": "tsx --test \"packages/*/test/**/*.test.ts\" \"scripts/test/*.test.ts\"",
    "test": "npm run build && npm run typecheck:test && npm run test:unit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ledger": "tsx scripts/check-ledger.ts",
    "links": "tsx scripts/check-links.ts",
    "fingerprint": "tsx scripts/source-fingerprint.ts",
    "check": "npm run test && npm run lint && npm run ledger && npm run links",
    "demo": "npm run build && node packages/cli/dist/index.js demo",
    "sim": "tsx packages/core/test/sim/sweep.ts 5000",
    "site": "npm run build && node packages/cli/dist/index.js trace > site/trace.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "homepage": "https://sebastianspicker.github.io/auto-pi-lot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianspicker/auto-pi-lot.git"
  },
  "bugs": {
    "url": "https://github.com/sebastianspicker/auto-pi-lot/issues"
  },
  "keywords": [
    "pi-coding-agent",
    "ai-agents",
    "coding-agent",
    "orchestration",
    "task-graph",
    "dag",
    "typescript"
  ]
}
