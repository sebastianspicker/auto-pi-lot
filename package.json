{
  "name": "auto-pi-lot",
  "version": "0.0.0",
  "private": true,
  "description": "Hierarchical graph orchestration for the Pi coding agent",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:unit": "tsx --test \"packages/*/test/**/*.test.ts\" \"scripts/test/*.test.ts\"",
    "test": "npm run build && npm run typecheck:test && npm run test:unit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ledger": "tsx scripts/check-ledger.ts",
    "links": "tsx scripts/check-links.ts",
    "fingerprint": "tsx scripts/source-fingerprint.ts",
    "check": "npm run test && npm run lint && npm run ledger && npm run links",
    "demo": "npm run build && node packages/cli/dist/index.js demo",
    "sim": "tsx packages/core/test/sim/sweep.ts 5000"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  }
}
